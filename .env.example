# A DNS name whose A record points to the Docker server's public IPv4.
# Do not add an AAAA record unless this server really accepts IPv6 traffic.
# See docs/domain-setup.md before starting Caddy.
DIVA_ADDRESS=remote.example.com
# Generate with: openssl rand -hex 32
DIVA_TOKEN=change-me-to-at-least-32-random-characters
# Leave this unchanged for DNS-only mode. For Cloudflare DNS-01 use:
# CADDYFILE_PATH=./Caddyfile.cloudflare
# CF_API_TOKEN=create-a-scoped-cloudflare-token
